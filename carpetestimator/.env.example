# ─────────────────────────────────────────────────────
# Carpet Estimator Pro — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────

# JWT signing secret for session cookies.
# Generate a strong random string (32+ chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# ROTATE THIS IN VERCEL DASHBOARD — never store the real value here.
JWT_SECRET=your-strong-random-secret-here

# Gumroad product IDs for each pricing tier.
# Find these in your Gumroad dashboard → Product → Edit → Product ID.
# Required: at least one must be set or verify-license will return 500.
GUMROAD_PRODUCT_ID_MONTHLY=your-monthly-product-id-here
GUMROAD_PRODUCT_ID_ANNUAL=your-annual-product-id-here
GUMROAD_PRODUCT_ID_LIFETIME=your-lifetime-product-id-here

# Gumroad product permalink (URL slug) — used on the checkout page.
# Not secret. Visible in the Gumroad product URL.
GUMROAD_PRODUCT_PERMALINK=carpetestimator
# Public variant used by client-side checkout page.
NEXT_PUBLIC_GUMROAD_PRODUCT_PERMALINK=carpetestimator
