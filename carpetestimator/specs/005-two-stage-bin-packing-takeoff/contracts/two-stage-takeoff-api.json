{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TwoStageTakeoffAPIContract",
  "description": "API Contract schema for Two-Stage Takeoff Optimization Engine",
  "type": "object",
  "properties": {
    "optimizeTwoStage": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "width": { "type": "number" },
                  "length": { "type": "number" }
                },
                "required": ["width", "length"]
              }
            },
            "rollWidth": { "type": "number" },
            "bleed": { "type": "number" }
          },
          "required": ["sections", "rollWidth"]
        }
      }
    }
  }
}
